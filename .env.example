# Copy this file to .env.local and fill real values
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PWA Web Push (re-engagement). Public key only — never put the private key in Vite env.
# Generate with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=

# Optional: public app URL for SMS/deep links when testing on localhost (defaults to https://smartlineman.in)
# VITE_PUBLIC_APP_URL=https://smartlineman.in

# Landing visit counter (Vercel Redis / Upstash + static fallback)
# LANDING_VISIT_BASELINE=12840
# VITE_LANDING_VISIT_BASELINE=12840
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are set when Redis is linked in Vercel
